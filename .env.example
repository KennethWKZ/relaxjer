# Test settings. Copy to .env (gitignored) or export them in your shell. No keys belong here.

# Optional: run the e2e tests against the old single-trip repo's engine instead of engine/ (to compare the two).
# LEGACY_ENGINE_DIR=/path/to/legacy-trip-repo

# Run the contract / data-agnostic e2e tests on a real trip instead of the demo (local only, never in CI).
# TRIP_DIR=/path/to/trip-folder

# Port for the local test server.
# RELAXJER_TEST_PORT=8124
