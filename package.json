{
	"name": "relaxjer",
	"version": "1.0.2",
	"private": true,
	"description": "An AI-assisted planner that turns a family's trip requirements into one offline-friendly, installable page.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.27.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KennethWKZ/relaxjer.git"
	},
	"bugs": {
		"url": "https://github.com/KennethWKZ/relaxjer/issues"
	},
	"homepage": "https://github.com/KennethWKZ/relaxjer#readme",
	"scripts": {
		"build": "node engine/build.mjs",
		"resync": "uv run --project pipeline pipeline/resync.py",
		"test": "node --test \"tests/repo/*.test.mjs\" \"tests/contract/*.test.mjs\" \"tests/unit/*.test.mjs\"",
		"test:pipeline": "uv run --quiet --project pipeline python -m unittest discover -s pipeline/tests -t pipeline",
		"setup:e2e": "playwright install chromium webkit",
		"test:e2e": "playwright test",
		"test:e2e:short": "node tests/support/short-trip.mjs && TRIP_DIR=.cache/trips/short-trip playwright test --grep-invert @demo",
		"test:all": "pnpm test && pnpm test:e2e && pnpm test:e2e:short",
		"test:release": "node --test \"tests/release/*.test.mjs\"",
		"test:sync-rules": "node scripts/sync/rules-test.mjs",
		"parity": "node tests/support/parity.mjs",
		"publish:trip": "node scripts/publish-trip.mjs",
		"sync": "node scripts/sync/sync.mjs",
		"lint": "eslint --max-warnings=0 --fix --cache .",
		"lint:check": "eslint --max-warnings=0 .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"gen:adr-index": "node scripts/docs-update/adr/gen-decision-index.mjs",
		"verify": "pnpm lint:check && pnpm format:check && pnpm test && pnpm test:pipeline",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "1.63.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"lavish-axi": "^0.1.79",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.9"
	}
}
