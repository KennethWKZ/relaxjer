# Real trips: requirements, data, photos, builds. Only the README is tracked.
/trips/*
!/trips/README.md

# Builds, caches, test output
/dist/
/.cache/
/test-results/
/playwright-report/
/blob-report/
node_modules/

# Secrets, wherever they land
.share/
.secrets/
*.key
*.pem
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.eslintcache

# Python (the data pipeline)
__pycache__/
*.pyc
.venv/

# Agent tooling: local-only state
/.claude/.write-flag
/.claude/settings.local.json
/.impeccable/hook.cache.json
/.impeccable/review/
/.impeccable/live/
