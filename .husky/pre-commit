# Blocks real trips, keys and builds from reaching the public repo, scans the staged diff for secrets, then lints and
# formats the staged files and runs the fast tests. Wired by `pnpm install` (the "prepare" script runs husky).
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACMR)

blocked=$(printf '%s\n' "$staged" | grep -E '^(trips/|\.share/|\.secrets/|dist/|\.cache/)|\.(key|pem)$|(^|/)\.env(\..+)?$' | grep -vE '^trips/README\.md$|(^|/)\.env\.example$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: these must never be committed (real trips, keys, builds):" >&2
  printf '  %s\n' $blocked >&2
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is required (brew install gitleaks). Refusing to commit unscanned." >&2
  exit 1
fi
gitleaks git --staged --redact --no-banner --config .gitleaks.toml

pnpm exec lint-staged
pnpm --silent test
